# Base de datos PeritoLine
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=your-db-name

# SSL (opcional)
DB_SSL_CA=/path/to/ca.pem
DB_SSL_CERT=/path/to/client-cert.pem
DB_SSL_KEY=/path/to/client-key.pem

# Credenciales ePAC (fallback si la BD no está disponible)
EPAC_URL=https://epac.example.com
EPAC_USERNAME=your-epac-user
EPAC_PASSWORD=your-epac-password
